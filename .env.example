FIREBASE_API_KEY=replace-with-firebase-web-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local desktop and packaged APK AI calls use Groq directly.
AI_BACKEND_URL=direct
GROQ_MODEL=openai/gpt-oss-20b
# Local desktop development: place your key here (do not commit .env).
# GROQ_API_KEY=replace-with-groq-api-key
# For an installed APK, enter the key in Settings instead; never pre-package it.
